version: '3.8'
# version: '3.11'

# If not docker-compose in legacy docker:
# sudo apt install docker-compose-plugin -y

services:
  # redis:
    # volumes:
      # - redis_cache:/data

  minio:
    image: minio/minio:latest
    container_name: minio-server-octadim
    restart: unless-stopped

    env_file:
      - ./envs/dev.env
      - ./envs/prod.env
      - ./envs/secrets.env

    ports:
      - "${MINIO_API_PORT:-9000}:9000"  # API port
      - "${MINIO_CONSOLE_PORT:-9001}:9001"  # Web console port

    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:?err_ROOT_USER_is_required}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD:?err_ROOT_PASSWORD_is_required}
      # MINIO_DEFAULT_BUCKETS: ${MINIO_DEFAULT_BUCKETS:-}

    volumes:
      # - ./${MINIO_BASE_DIRECTORY:-TEMP_MINIO_FILES}:/data  # Relative path from docker-compose.yml
      # - /absolute/path/to/minio/data:/data  # Absolute server path
      - minio_mounted_shared:/data  # Auto directory inside docker volumes system or mounted directory in volumes

    command: server /data --console-address ":${MINIO_CONSOLE_PORT:-9001}"

    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]  # Curl not installed in all Minio images
      # test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 20s
      retries: 5

    networks:
      - minio_network

    stop_grace_period: 5m  # Soft stop SIGTERM grace period, before killing process

    deploy:  # Resources limits
      resources:
        limits:
          cpus: '2'
          memory: 2G
        reservations:
          cpus: '0.5'
          memory: 512M

    logging:  # Logging
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"


volumes:
  minio_mounted_shared:  # Mounted, with share access
    driver: local
    driver_opts:
      type: none
      device: ./../${MINIO_BASE_DIRECTORY:-TEMP_MINIO_FILES}  # IMPORTANT: relative from docker-compose.yaml run directory
      o: bind,shared

  # db_volume:  # Separate speed volume for Data Base
    # driver: local
    # driver_opts:
      # type: none
      # device: ./${MINIO_BASE_DIRECTORY:-MINIO_FILES}  # SSD disk for example
      # o: bind

  # config_volume:  # Read-only, for configs
    # driver: local
    # driver_opts:
      # type: none
      # device: /etc/app/configs
      # o: bind,ro  # Read-Only

