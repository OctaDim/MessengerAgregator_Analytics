### With checking Redis installed, comparing minimal required Redis version,
### auto-installing or auto-updating Redis, auto-starting Redis and starting
### the service itself
### NOTE: script uncommented and working
[Unit]
Description=MessengerAgregator_Analytics
After=network.target redis-server.service
Requires=redis-server.service
[Service]
User=octadim
WorkingDirectory=/usr/local/MessengerAgregator_Analytics
ExecStartPre=/bin/bash -c '/usr/local/MessengerAgregator_Analytics/db_redis/check_version_auto_install_redis.sh'
ExecStart=/usr/local/MessengerAgregator_Analytics/.venv31211_pyann/bin/python3.12 /usr/local/MessengerAgregator_Analytics/main.py
Restart=always
RestartSec=180
Type=simple
StandardOutput=journal
StandardError=journal
#StandardOutput=file:/var/log/messenger_aggregator/aggregator.log
#StandardError=file:/var/log/messenger_aggregator/aggregator.err
LogLevelMax=debug
[Install]
WantedBy=multi-user.target


