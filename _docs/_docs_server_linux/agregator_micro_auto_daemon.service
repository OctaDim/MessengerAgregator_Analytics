[Unit]
Description=MessengerAgregator_Analytics
After=network.target
#After=network.target redis-server.service
[Service]
User=octadim
WorkingDirectory=/home/octadim/PycharmProjects/MessengerAgregator_Analytics
#ExecStartPre=/bin/bash -c '/home/octadim/PycharmProjects/MessengerAgregator_Analytics/db_redis/check_version_auto_install_redis.sh'
ExecStart=/home/octadim/PycharmProjects/MessengerAgregator_Analytics/.venv31211/bin/python3.12 /home/octadim/PycharmProjects/MessengerAgregator_Analytics/main.py
Restart=always
RestartSec=180
Type=simple
StandardOutput=journal
StandardError=journal
#StandardOutput=file:/var/log/messenger_aggregator/aggregator.log
#StandardError=file:/var/log/messenger_aggregator/aggregator.err
LogLevelMax=debug
[Install]
WantedBy=multi-user.target
